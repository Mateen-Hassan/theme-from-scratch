<form method="post" action="/cart/add">
  <input
    type="hidden"
    name="id"
    value="{{product.selected_or_first_available_variant.id}}">
  <input
    type="hidden"
    name="quantity"
    value="1">

  <atc-button>
    <button type="submit" class="button" onclick="popop()">Add to Cart</button>
  </atc-button>
</form>

