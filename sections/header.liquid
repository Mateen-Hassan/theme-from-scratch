{% comment %} 
    Simple Shopify Header with Dynamic Menu Support
{% endcomment %}

<header class="site-header" data-site-header>
  <div class="header-container">

    <!-- Mobile Menu Toggle -->
    <button
      class="mobile-menu-toggle"
      data-mobile-menu-toggle
      aria-label="Menu">
      <i class="fas fa-bars"></i>
    </button>

    <!-- Logo -->
    <div class="header-logo">
      <a href="/" class="logo-link">
        {% if settings.logo != blank %}
          <img
            src="{{ settings.logo | img_url: '180x' }}"
            alt="{{ shop.name }}"
            class="logo-image"
            loading="lazy">
        {% else %}
          <span class="logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header-nav" data-header-nav>
      <ul class="nav-list">
        {% for link in linklists[section.settings.main_menu].links %}
          <li class="nav-item">
            <a href="{{ link.url }}" class="nav-link {% if link.title contains 'Sale' %}sale-link{% endif %}">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">

      <!-- Search -->
      <button
        class="header-action-btn search-toggle"
        data-search-toggle
        aria-label="Search">
        <i class="fas fa-search"></i>
      </button>

      <!-- Account -->
      <a
        href="/account"
        class="header-action-btn"
        aria-label="Account">
        <i class="fas fa-user"></i>
      </a>

      <!-- Cart -->
      <button
        class="cart-drawer-trigger header-action-btn cart-btn"
        data-cart-drawer-toggle
        aria-label="Cart">
        <i class="fas fa-shopping-cart"></i>

        <span class="cart-count-badge" data-cart-count-display>
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div class="mobile-nav" data-mobile-nav>

    <div class="mobile-nav-header">
      <span class="mobile-nav-title">Menu</span>

      <button class="mobile-nav-close" data-mobile-nav-close>
        <i class="fas fa-times"></i>
      </button>
    </div>

    <ul class="mobile-nav-list">

      {% for link in linklists[section.settings.main_menu].links %}
        <li class="mobile-nav-item">
          <a href="{{ link.url }}" class="mobile-nav-link {% if link.title contains 'Sale' %}sale-link{% endif %}">
            {{ link.title }}
          </a>
        </li>
      {% endfor %}

      <li class="mobile-nav-item">
        <a href="/account" class="mobile-nav-link">
          <i class="fas fa-user"></i>
          My Account
        </a>
      </li>

    </ul>
  </div>

  <!-- Search Bar -->
  <div class="search-bar" data-search-bar>

    <div class="search-container">

      <form
        action="/search"
        method="get"
        class="search-form"
        role="search">

        <input
          type="hidden"
          name="type"
          value="product">

        <input
          type="text"
          name="q"
          placeholder="Search for products..."
          class="search-input"
          autocomplete="off">

        <button type="submit" class="search-submit">
          <i class="fas fa-search"></i>
        </button>

        <button
          type="button"
          class="search-close"
          data-search-close>
          <i class="fas fa-times"></i>
        </button>

      </form>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: {{ section.settings.header_bg }};
    border-bottom: 1px solid #e5e5e5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .header-logo {
    flex-shrink: 0;
  }

  .logo-image {
    max-height: 45px;
    width: auto;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
  }

  .header-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    text-decoration: none;
    color: #333;
    font-weight: 500;
    transition: 0.2s;
  }

  .nav-link:hover {
    color: #000;
  }

  .sale-link {
    color: #e74c3c;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    position: relative;
    color: #333;
  }

  .cart-count-badge {
    position: absolute;
    top: -7px;
    right: -10px;
    background: #111;
    color: white;
    min-width: 18px;
    height: 18px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
  }

  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 320px;
    height: 100vh;
    background: white;
    z-index: 1001;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    box-shadow: 2px 0 15px rgba(0, 0, 0, 0.1);
  }

  .mobile-nav.active {
    transform: translateX(0);
  }

  .mobile-nav-header {
    padding: 1.25rem;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #eee;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 1rem 1.5rem;
    text-decoration: none;
    color: #333;
    border-bottom: 1px solid #f5f5f5;
  }

  .search-bar {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    padding: 1rem;
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
  }

  .search-bar.active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .search-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .search-form {
    display: flex;
    gap: 0.5rem;
  }

  .search-input {
    flex: 1;
    padding: 0.85rem 1rem;
    border: 1px solid #ddd;
    border-radius: 50px;
  }

  .search-submit,
  .search-close {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
  }

  .search-submit {
    background: #111;
    color: white;
  }

  .search-close {
    background: #eee;
  }

  @media (max-width: 768px) {

    .mobile-menu-toggle {
      display: block;
    }

    .header-nav {
      display: none;
    }

    .header-container {
      padding: 0.75rem 1rem;
    }

    .logo-image {
      max-height: 36px;
    }
  }
</style>

<script>
  (function () {
  
    const mobileToggle = document.querySelector('[data-mobile-menu-toggle]');
    const mobileNav = document.querySelector('[data-mobile-nav]');
    const mobileClose = document.querySelector('[data-mobile-nav-close]');
  
    const searchToggle = document.querySelector('[data-search-toggle]');
    const searchBar = document.querySelector('[data-search-bar]');
    const searchClose = document.querySelector('[data-search-close]');
  
    let mobileOverlay = document.querySelector('.mobile-nav-overlay');
  
    if (!mobileOverlay && mobileNav) {
      mobileOverlay = document.createElement('div');
      mobileOverlay.className = 'mobile-nav-overlay';
      document.body.appendChild(mobileOverlay);
  
      mobileOverlay.style.cssText = `
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: 0.3s;
      `;
    }
  
    function openMobileMenu() {
      mobileNav.classList.add('active');
  
      mobileOverlay.style.opacity = '1';
      mobileOverlay.style.visibility = 'visible';
  
      document.body.style.overflow = 'hidden';
    }
  
    function closeMobileMenu() {
      mobileNav.classList.remove('active');
  
      mobileOverlay.style.opacity = '0';
      mobileOverlay.style.visibility = 'hidden';
  
      document.body.style.overflow = '';
    }
  
    if (mobileToggle) {
      mobileToggle.addEventListener('click', openMobileMenu);
    }
  
    if (mobileClose) {
      mobileClose.addEventListener('click', closeMobileMenu);
    }
  
    if (mobileOverlay) {
      mobileOverlay.addEventListener('click', closeMobileMenu);
    }
  
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });
  
    function openSearch() {
      searchBar.classList.add('active');
  
      const input = searchBar.querySelector('.search-input');
  
      if (input) {
        input.focus();
      }
    }
  
    function closeSearch() {
      searchBar.classList.remove('active');
    }
  
    if (searchToggle) {
      searchToggle.addEventListener('click', openSearch);
    }
  
    if (searchClose) {
      searchClose.addEventListener('click', closeSearch);
    }
  
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMobileMenu();
        closeSearch();
      }
    });
  
  })();
</script>

{% schema %}
  {
    "name": "Simple Header",
    "settings": [
      {
        "type": "header",
        "content": "Header Settings"
      }, {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "Enable Sticky Header",
        "default": true
      }, {
        "type": "color",
        "id": "header_bg",
        "label": "Header Background",
        "default": "#ffffff"
      }, {
        "type": "link_list",
        "id": "main_menu",
        "label": "Navigation Menu",
        "default": "main-menu"
      }
    ],
    "presets": [
      {
        "name": "Simple Header"
      }
    ]
  }
{% endschema %}