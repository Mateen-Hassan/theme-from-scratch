{% comment %} 
                              Simple Shopify Header with Dynamic Menu Support
{% endcomment %}

<header class="site-header" data-site-header>
  <div class="header-container">

    <!-- Mobile Menu Toggle -->
    <button
      class="mobile-menu-toggle"
      data-mobile-menu-toggle
      aria-label="Menu">
      <i class="fas fa-bars"></i>
    </button>

    <!-- Logo -->
    <div class="header-logo">
      <a href="/" class="logo-link">
        {% if settings.logo != blank %}
          <img
            src="{{ settings.logo | img_url: '180x' }}"
            alt="{{ shop.name }}"
            class="logo-image"
            loading="lazy">
        {% else %}
          <span class="logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header-nav" data-header-nav>
      <ul class="nav-list">
        {% for link in linklists[section.settings.main_menu].links %}
          {% assign is_catalog = false %}
          {% if link.title == section.settings.mega_menu_trigger %}
            {% assign is_catalog = true %}
          {% endif %}
          <li class="nav-item{% if is_catalog %} nav-item--mega{% endif %}">
            {% if is_catalog %}
              <button
                type="button"
                class="nav-link nav-link--mega-trigger"
                data-mega-trigger
                aria-haspopup="true"
                aria-expanded="false">
                {{ link.title }}
                <i class="fas fa-chevron-down nav-link__chevron" aria-hidden="true"></i>
              </button>
              {% render 'mega-menu'
                , section: section %}
            {% else %}
              <a href="{{ link.url }}" class="nav-link {% if link.title contains 'Sale' %}sale-link{% endif %}">
                {{ link.title }}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">

      <!-- Search -->
      <button
        class="header-action-btn search-toggle"
        data-search-toggle
        aria-label="Search">
        <i class="fas fa-search"></i>
      </button>

      <!-- Account -->
      <a
        href="/account"
        class="header-action-btn"
        aria-label="Account">
        <i class="fas fa-user"></i>
      </a>

      <!-- Cart -->
      <button
        class="cart-drawer-trigger header-action-btn cart-btn"
        data-cart-drawer-toggle
        aria-label="Cart">
        <i class="fas fa-shopping-cart"></i>

        <span class="cart-count-badge" data-cart-count-display>
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div class="mobile-nav" data-mobile-nav>

    <div class="mobile-nav-header">
      <span class="mobile-nav-title">Menu</span>

      <button class="mobile-nav-close" data-mobile-nav-close>
        <i class="fas fa-times"></i>
      </button>
    </div>

    <ul class="mobile-nav-list">

      {% for link in linklists[section.settings.main_menu].links %}
        {% assign is_catalog_mobile = false %}
        {% if link.title == section.settings.mega_menu_trigger %}
          {% assign is_catalog_mobile = true %}
        {% endif %}
        <li class="mobile-nav-item{% if is_catalog_mobile %} mobile-nav-item--mega{% endif %}">
          {% if is_catalog_mobile %}
            <button
              type="button"
              class="mobile-nav-link mobile-nav-mega-toggle"
              data-mobile-mega-toggle
              aria-expanded="false">
              {{ link.title }}
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div
              class="mobile-mega-menu"
              data-mobile-mega-menu
              hidden>
              {% render 'mega-menu'
                , section: section %}
            </div>
          {% else %}
            <a href="{{ link.url }}" class="mobile-nav-link {% if link.title contains 'Sale' %}sale-link{% endif %}">
              {{ link.title }}
            </a>
          {% endif %}
        </li>
      {% endfor %}

      <li class="mobile-nav-item">
        <a href="/account" class="mobile-nav-link">
          <i class="fas fa-user"></i>
          My Account
        </a>
      </li>

    </ul>
  </div>

  <!-- Search Bar -->
  <div class="search-bar" data-search-bar>

    <div class="search-container">

      <form
        action="/search"
        method="get"
        class="search-form"
        role="search">

        <input
          type="hidden"
          name="type"
          value="product">

        <input
          type="text"
          name="q"
          placeholder="Search for products..."
          class="search-input"
          autocomplete="off">

        <button type="submit" class="search-submit">
          <i class="fas fa-search"></i>
        </button>

        <button
          type="button"
          class="search-close"
          data-search-close>
          <i class="fas fa-times"></i>
        </button>

      </form>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    /* Anchor full-width mega menu panel */
    isolation: isolate;
    background: {{ section.settings.header_bg }};
    border-bottom: 1px solid #e5e5e5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .header-logo {
    flex-shrink: 0;
  }

  .logo-image {
    max-height: 45px;
    width: auto;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
  }

  .header-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    text-decoration: none;
    color: #333;
    font-weight: 500;
    transition: 0.2s;
  }

  .nav-link:hover {
    color: #000;
  }

  .sale-link {
    color: #e74c3c;
  }

  .nav-item--mega {
    position: static;
  }

  .nav-link--mega-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .nav-link__chevron {
    font-size: 0.65rem;
    transition: transform 0.2s ease;
  }

  .nav-item--mega.is-open .nav-link__chevron {
    transform: rotate(180deg);
  }

  .mega-menu {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    border-top: 1px solid #eee;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    z-index: 90;
  }

  .mega-menu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 12px;
  }

  .nav-item--mega.is-hover .mega-menu,
  .nav-item--mega.is-clicked .mega-menu,
  .nav-item--mega.is-open .mega-menu,
  .nav-item--mega:focus-within .mega-menu {
    display: block;
  }

  .mega-menu__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .mega-menu__columns {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 2rem;
  }

  .mega-menu__column-title {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111;
  }

  .mega-menu__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mega-menu__links li + li {
    margin-top: 0.5rem;
  }

  .mega-menu__link {
    text-decoration: none;
    color: #555;
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .mega-menu__link:hover {
    color: #000;
  }

  .mega-menu__promo {
    flex-shrink: 0;
    width: min(240px, 28vw);
  }

  .mega-menu__promo-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .mega-menu__promo-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .mega-menu__promo-content {
    margin-top: 0.75rem;
  }

  .mega-menu__promo-heading {
    margin: 0 0 0.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #111;
  }

  .mega-menu__promo-text {
    margin: 0;
    font-size: 0.8125rem;
    color: #666;
    line-height: 1.4;
  }

  .mobile-nav-mega-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .mobile-nav-item--mega.is-open .mobile-nav-mega-toggle i {
    transform: rotate(180deg);
  }

  .mobile-mega-menu {
    background: #fafafa;
    border-bottom: 1px solid #f0f0f0;
  }

  .mobile-mega-menu .mega-menu {
    display: none;
    position: static;
    box-shadow: none;
    border: none;
  }

  .mobile-mega-menu:not([hidden]) .mega-menu {
    display: block;
  }

  .mobile-mega-menu .mega-menu__inner {
    flex-direction: column;
    padding: 1rem 1.5rem 1.25rem;
    gap: 1.5rem;
  }

  .mobile-mega-menu .mega-menu__promo {
    width: 100%;
    max-width: 280px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    position: relative;
    color: #333;
  }

  .cart-count-badge {
    position: absolute;
    top: -7px;
    right: -10px;
    background: #111;
    color: white;
    min-width: 18px;
    height: 18px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
  }

  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 320px;
    height: 100vh;
    background: white;
    z-index: 1001;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    box-shadow: 2px 0 15px rgba(0, 0, 0, 0.1);
  }

  .mobile-nav.active {
    transform: translateX(0);
  }

  .mobile-nav-header {
    padding: 1.25rem;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #eee;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 1rem 1.5rem;
    text-decoration: none;
    color: #333;
    border-bottom: 1px solid #f5f5f5;
  }

  .search-bar {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    padding: 1rem;
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
  }

  .search-bar.active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .search-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .search-form {
    display: flex;
    gap: 0.5rem;
  }

  .search-input {
    flex: 1;
    padding: 0.85rem 1rem;
    border: 1px solid #ddd;
    border-radius: 50px;
  }

  .search-submit,
  .search-close {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
  }

  .search-submit {
    background: #111;
    color: white;
  }

  .search-close {
    background: #eee;
  }

  @media (max-width: 768px) {

    .mobile-menu-toggle {
      display: block;
    }

    .header-nav {
      display: none;
    }

    .header-container {
      padding: 0.75rem 1rem;
    }

    .logo-image {
      max-height: 36px;
    }
  }
</style>

<script>
  (function () {
  
    const mobileToggle = document.querySelector('[data-mobile-menu-toggle]');
    const mobileNav = document.querySelector('[data-mobile-nav]');
    const mobileClose = document.querySelector('[data-mobile-nav-close]');
  
    const searchToggle = document.querySelector('[data-search-toggle]');
    const searchBar = document.querySelector('[data-search-bar]');
    const searchClose = document.querySelector('[data-search-close]');
  
    let mobileOverlay = document.querySelector('.mobile-nav-overlay');
  
    if (!mobileOverlay && mobileNav) {
      mobileOverlay = document.createElement('div');
      mobileOverlay.className = 'mobile-nav-overlay';
      document.body.appendChild(mobileOverlay);
  
      mobileOverlay.style.cssText = `
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: 0.3s;
      `;
    }
  
    function openMobileMenu() {
      mobileNav.classList.add('active');
  
      mobileOverlay.style.opacity = '1';
      mobileOverlay.style.visibility = 'visible';
  
      document.body.style.overflow = 'hidden';
    }
  
    function closeMobileMenu() {
      mobileNav.classList.remove('active');
  
      mobileOverlay.style.opacity = '0';
      mobileOverlay.style.visibility = 'hidden';
  
      document.body.style.overflow = '';
    }
  
    if (mobileToggle) {
      mobileToggle.addEventListener('click', openMobileMenu);
    }
  
    if (mobileClose) {
      mobileClose.addEventListener('click', closeMobileMenu);
    }
  
    if (mobileOverlay) {
      mobileOverlay.addEventListener('click', closeMobileMenu);
    }
  
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });
  
    function openSearch() {
      searchBar.classList.add('active');
  
      const input = searchBar.querySelector('.search-input');
  
      if (input) {
        input.focus();
      }
    }
  
    function closeSearch() {
      searchBar.classList.remove('active');
    }
  
    if (searchToggle) {
      searchToggle.addEventListener('click', openSearch);
    }
  
    if (searchClose) {
      searchClose.addEventListener('click', closeSearch);
    }
  
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMobileMenu();
        closeSearch();
        closeMegaMenus();
      }
    });
  
    const megaNavItems = document.querySelectorAll('.nav-item--mega');
  
    function isMegaOpen(item) {
      return item.classList.contains('is-hover')
        || item.classList.contains('is-clicked')
        || item.matches(':focus-within');
    }
  
    function syncMegaState(item) {
      const trigger = item.querySelector('[data-mega-trigger]');
      const open = isMegaOpen(item);
  
      item.classList.toggle('is-open', open);
  
      if (trigger) {
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
    }
  
    function closeMegaMenus() {
      megaNavItems.forEach(item => {
        item.classList.remove('is-hover', 'is-clicked', 'is-open');
        syncMegaState(item);
      });
    }
  
    function closeOtherMegaClicks(activeItem) {
      megaNavItems.forEach(item => {
        if (item !== activeItem) {
          item.classList.remove('is-clicked');
          syncMegaState(item);
        }
      });
    }
  
    megaNavItems.forEach(item => {
      const trigger = item.querySelector('[data-mega-trigger]');
  
      item.addEventListener('mouseenter', () => {
        item.classList.add('is-hover');
        syncMegaState(item);
      });
  
      item.addEventListener('mouseleave', () => {
        item.classList.remove('is-hover');
        syncMegaState(item);
      });
  
      if (trigger) {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
  
          const willOpen = !item.classList.contains('is-clicked');
  
          closeOtherMegaClicks(item);
          item.classList.toggle('is-clicked', willOpen);
          syncMegaState(item);
        });
      }
  
      item.addEventListener('focusin', () => syncMegaState(item));
  
      item.addEventListener('focusout', (e) => {
        if (!item.contains(e.relatedTarget)) {
          item.classList.remove('is-clicked');
          syncMegaState(item);
        }
      });
    });
  
    document.addEventListener('click', (e) => {
      const insideMega = e.target.closest('.nav-item--mega');
  
      megaNavItems.forEach(item => {
        if (item !== insideMega) {
          item.classList.remove('is-clicked');
          syncMegaState(item);
        }
      });
    });
  
    document.querySelectorAll('[data-mobile-mega-toggle]').forEach(toggle => {
      toggle.addEventListener('click', () => {
        const item = toggle.closest('.mobile-nav-item--mega');
        const panel = item?.querySelector('[data-mobile-mega-menu]');
        const isOpen = item?.classList.toggle('is-open');
  
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  
        if (panel) {
          panel.hidden = !isOpen;
        }
      });
    });
  
  })();
</script>

{% schema %}
  {
    "name": "Simple Header",
    "settings": [
      {
        "type": "header",
        "content": "Header Settings"
      },
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "Enable Sticky Header",
        "default": true
      },
      {
        "type": "color",
        "id": "header_bg",
        "label": "Header Background",
        "default": "#ffffff"
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Navigation Menu",
        "default": "main-menu"
      }, {
        "type": "header",
        "content": "Catalog mega menu"
      }, {
        "type": "text",
        "id": "mega_menu_trigger",
        "label": "Mega menu nav item title",
        "default": "Catalog",
        "info": "Must match the title of a link in the navigation menu above."
      }, {
        "type": "image_picker",
        "id": "mega_menu_image",
        "label": "Promo image (right side)"
      }, {
        "type": "text",
        "id": "mega_menu_image_alt",
        "label": "Promo image alt text"
      }, {
        "type": "url",
        "id": "mega_menu_image_link",
        "label": "Promo image link"
      }, {
        "type": "text",
        "id": "mega_menu_image_heading",
        "label": "Promo heading"
      }, {
        "type": "text",
        "id": "mega_menu_image_text",
        "label": "Promo text"
      }
    ],
    "blocks": [
      {
        "type": "menu_item",
        "name": "Link column",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Column heading",
            "default": "Shop"
          }, {
            "type": "link_list",
            "id": "menu",
            "label": "Link list"
          }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [
      {
        "name": "Simple Header",
        "blocks": [
          {
            "type": "menu_item",
            "settings": {
              "title": "Categories"
            }
          }, {
            "type": "menu_item",
            "settings": {
              "title": "Collections"
            }
          }
        ]
      }
    ]
  }
{% endschema %}