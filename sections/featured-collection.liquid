{% comment %} 
                                                                                                Simple Featured Collection Section
{% endcomment %}

<section class="featured-collection">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% assign collection = collections[section.settings.collection] %}

    <div class="featured-collection__grid">
      {% for product in collection.products limit: section.settings.products_to_show %}

        <div class="featured-collection__card">

          <a href="{{ product.url }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.title }}"
                width="600"
                height="600">
            {% endif %}
          </a>

          <h3>{{ product.title }}</h3>

          <p>{{ product.price | money }}</p>

          <a href="{{ product.url }}" class="featured-collection__button">
            View Product
          </a>
          {% render 'atc-button'
            , product: product %}
        </div>
      {% endfor %}
      <div class="popup">
<p>to kesy hai ap log</p>
</div>
{% style %}
  .popup{
    display: block;
    position: fixed;
    height:90%;
    width: 90%;
    background-color: black;

  }
{% endstyle %}
    </div>

  </div>
</section>

<style>
  .featured-collection {
    padding: 60px 20px;
  }

  .featured-collection__heading {
    text-align: center;
    margin-bottom: 40px;
    font-size: 32px;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .featured-collection__card {
    border: 1px solid #e5e5e5;
    padding: 15px;
    text-align: center;
    border-radius: 10px;
  }

  .featured-collection__card img {
    width: 100%;
    display: block;
    border-radius: 8px;
  }

  .featured-collection__card h3 {
    margin: 15px 0 10px;
    font-size: 18px;
  }

  .featured-collection__button {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 20px;
    background: black;
    color: white;
    text-decoration: none;
    border-radius: 5px;
  }

  @media screen and (max-width: 768px) {
    .featured-collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{% schema %}
  {
    "name": "Featured Collection",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Featured Collection"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Select Collection"
      }, {
        "type": "range",
        "id": "products_to_show",
        "label": "Products to Show",
        "min": 2,
        "max": 12,
        "step": 1,
        "default": 4
      }
    ],
    "presets": [
      {
        "name": "Featured Collection"
      }
    ]
  }
{% endschema %}